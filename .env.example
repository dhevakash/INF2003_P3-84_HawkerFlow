# Docker overrides DATABASE_URL and MONGO_URI with internal service addresses.
APP_ENV=development
JWT_SECRET=change-this-to-a-long-random-secret-before-sharing
DATABASE_URL=mysql+pymysql://hawkerflow:hawkerflow_dev@127.0.0.1:3306/hawkerflow
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DATABASE=hawkerflow
