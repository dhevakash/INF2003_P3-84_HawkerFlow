{
  "$jsonSchema": {
    "bsonType": "object",
    "required": [
      "order_id",
      "customer_id",
      "branch_id",
      "rating",
      "text",
      "tags",
      "created_at",
      "replies",
      "source"
    ],
    "properties": {
      "order_id": {
        "bsonType": [
          "int",
          "long"
        ],
        "minimum": 1
      },
      "customer_id": {
        "bsonType": [
          "int",
          "long"
        ],
        "minimum": 1
      },
      "branch_id": {
        "bsonType": [
          "int",
          "long"
        ],
        "minimum": 1
      },
      "rating": {
        "bsonType": [
          "int",
          "long"
        ],
        "minimum": 1,
        "maximum": 5
      },
      "text": {
        "bsonType": "string",
        "minLength": 3,
        "maxLength": 2000
      },
      "tags": {
        "bsonType": "array",
        "maxItems": 10,
        "uniqueItems": true,
        "items": {
          "bsonType": "string",
          "minLength": 1,
          "maxLength": 40
        }
      },
      "created_at": {
        "bsonType": "date"
      },
      "updated_at": {
        "bsonType": "date"
      },
      "source": {
        "enum": [
          "synthetic_purchase",
          "application_purchase"
        ]
      },
      "category_ratings": {
        "bsonType": "object",
        "additionalProperties": false,
        "properties": {
          "food": {
            "bsonType": [
              "int",
              "long"
            ],
            "minimum": 1,
            "maximum": 5
          },
          "service": {
            "bsonType": [
              "int",
              "long"
            ],
            "minimum": 1,
            "maximum": 5
          },
          "value": {
            "bsonType": [
              "int",
              "long"
            ],
            "minimum": 1,
            "maximum": 5
          }
        }
      },
      "replies": {
        "bsonType": "array",
        "maxItems": 20,
        "items": {
          "bsonType": "object",
          "required": [
            "manager_user_id",
            "text",
            "created_at"
          ],
          "properties": {
            "manager_user_id": {
              "bsonType": [
                "int",
                "long"
              ]
            },
            "text": {
              "bsonType": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "created_at": {
              "bsonType": "date"
            }
          }
        }
      }
    }
  }
}
